#application
NODE_ENV=development 
PORT=4000

#MQTT BROKER
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=iot-monitoring-backend

#MQTT subscriptions
MQTT_TELEMETRY_TOPIC=iot/devices/+/telemetry
MQTT_STATUS_TOPIC=IoT/devices/+/status

#PostgreSQL Database
DATABASE_URL=postgresql://iot_user:replace_me@localhost:5432/iot_monitoring?schema=public